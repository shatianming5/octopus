# RL_ENV_FILE for scripts/rl_env/rl_run.sh and eval_serve.sh on NVwulf: Qwen3.5-4B bundle RL with node-94's
# rl_run.4b-v2.env's (see commit a6e83a9) model, adapter and knobs, on one h200x8 node (5 rollout + 3 training GPUs; train.sbatch).
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/env.sh"
AREAL_PY=$N/areal/.venv/bin/python
SGLANG_PY=$N/sglang-venv/bin/python
CODE=$N/code
MODEL_TEXT=$N/models/Qwen3.5-4B-text
MODEL_VL=$N/models/Qwen3.5-4B
ADAPTER0=$N/models/adapter-v0-4b-text-r64
FILEROOT=$N/areal-exp
STATE=$N/state
JOBS_ROOT=$N/jobs
CUDA_HOME=/cm/shared/apps/cuda12.8/toolkit/12.8.1
INFER_GPUS=0,1,2,3,4
TRAIN_GPUS=5,6,7
STEPS=200
EXCLUDE=
MEM_MAX=job
EPISODES_PER_SERVER=20
MB_TOKENS=262144
OFFPOLICY=3
LORA_RANK=64
LORA_KEEP=30
# 0.88 is a chosen fraction, not a read-tool floor. bundles-v2-valid is what this launcher was written for;
# track A is not on this path.
MEM_FRAC=0.88
EXTRA="actor.optimizer.lr=2e-5 rl.plan_tasks=$N/datasets/bundles-v2-valid.train.txt"
# Group size 8 x 4 groups (bundles) per step = 32 episodes (grpo.yaml defaults: n_samples 8, batch_size 16):
# EXTRA="$EXTRA gconfig.n_samples=8 train_dataset.batch_size=4"
# OCTOPUS_AUTO_MERGE (default 1 for a bundle): the runtime merges committed branch patches at each join;
# 0 leaves merging to the model and credits a bundle branch by its task in the final tree:
# export OCTOPUS_AUTO_MERGE=0
