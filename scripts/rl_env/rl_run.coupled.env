# coupled: track A bundles (2-4 strongly coupled tasks in one file). One env for Gate 0 (docs/cross-branch-read.md
# "Gate 0", eval only, base model) and Step 4's training. From bundle-e14-read (rl_run.bundle-e14-read.env sourcing
# rl_run.bundle-e13-read.env, both at commit a6e83a9) with the pure outcome reward R = 2y-1 (docs/rl-plan-episodes.md
# "Reward"; the e9-e14 credit knobs and rl.plan_lambda / plan_alpha are gone from the code, rl.plan_control is off by
# default) and the read tool off. Gate 0 (scripts/eval/gate0_shard.sh) adds by dev_eval --env, never here (eval only):
# OCTOPUS_AUTO_FORK=1 in both arms (#222), OCTOPUS_READ_TOOL=1 OCTOPUS_READ_EVENT=1 in arm 3. A read training uses a copy
# of this file that exports OCTOPUS_READ_TOOL=1. Host paths under OCTO_ENV (default ~/octo-env: node-134/136/68/138; scripts/deploy.sh's
# ROOT/harbor/scripts/env.sh sets it and OCTOPUS_HARBOR, the Harbor dir with the task data, for its deployment).
# Bundle mode comes from the task dir (octopus/envs/swe/rl.py), forks are synchronous (#217).
# Gate 0 settings (rl_run.sh settings does not add EXTRA): source this file, then
#   RL_ENV_FILE=<this> rl_run.sh settings $G/run $EXTRA rollout.use_lora=false
OCTO_ENV=${OCTO_ENV:-$HOME/octo-env}
export OCTOPUS_HARBOR=${OCTOPUS_HARBOR:-/home/user/harbor-udocker}
AREAL_PY=$OCTO_ENV/areal/.venv/bin/python
SGLANG_PY=$OCTO_ENV/sglang-venv/bin/python
CODE=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
# CODE is a code-<sha> dir; this overlay is built from its patches/ at each deployment (docs/cursor-protocol.md
# "Deployment"), never reused from an older commit (#214 changed areal-cursor.patch)
CURSOR=$OCTO_ENV/cursor-${CODE##*/code-}
MODEL_TEXT=$OCTO_ENV/models/Qwen3.5-4B-text
MODEL_VL=$OCTO_ENV/models/Qwen3.5-4B
ADAPTER0=$OCTO_ENV/models/adapter-v0-4b-text-r64
FILEROOT=$OCTO_ENV/areal-exp
STATE=$OCTO_ENV/rl-state-coupled
ROLLOUT_SPOOL=$STATE/spool
INFER_GPUS=0,1,2
TRAIN_GPUS=3,4,5,6,7
PORT0=31300
STEPS=40
EXCLUDE=""
MEM_MAX=400G
CUDA_HOME=${CUDA_HOME:-/usr/local/cuda-12.9}
EPISODES_PER_SERVER=8
OFFPOLICY=2
LORA_RANK=64
LORA_KEEP=10
MEM_FRAC=${MEM_FRAC:-0.88}  # this file's chosen --mem-fraction-static; Gate 0 sets it per host (shared GPUs)
# e13's KV pool; without e13-read's no_buffer + overlap off, which the mount no longer needs (#172) and which cost ~7%
# speed: this run is not compared step by step with e14 (other data, other reward)
SGLANG_ARGS="--mamba-full-memory-ratio 0.45"
MB_TOKENS=196608
export OCTOPUS_CONFLICT_BY=1 OCTOPUS_CODE=$CODE
# Branch limits (user, 1b), as search's (octopus/envs/search/defaults.py) except main's and a branch's call caps:
export OCTOPUS_FORK_DEPTH=1  # only main forks (runtime/tree.fork_depth, default 2); search's
export OCTOPUS_MAIN_MAX_CALLS=120  # main's tool calls (runtime/settings.call_limit); e14's
export OCTOPUS_BRANCH_MAX_TURNS=100  # a branch's turns (runtime/core.branch_turns, already its default); e14's
# branches per episode, any depth (runtime/tree.max_branches, default none); search's. Not 4: after the first fork
# of a 3-4 task bundle, main must still be able to fork again for the tasks whose patches the join took back
export OCTOPUS_MAX_BRANCHES=10
EXTRA="train_dataset.batch_size=4 rl.plan_tasks=$OCTOPUS_HARBOR/datasets/coupled-a-train"  # the rest of e14's EXTRA is grpo.yaml's default now
