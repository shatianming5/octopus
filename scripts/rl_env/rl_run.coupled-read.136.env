# node-136 (RTX 4090D, GPUs 3-4) as rl_run.coupled-read.env's REMOTE rollout host, from the same code dir path as the trainer's:
# `rl_run.sh tunnel` here puts this sshd on node-94's 127.0.0.1:2238 and each server port 30800+ on the same node-94 port.
# GPUs another user holds stay out: check nvidia-smi and set INFER_GPUS (append a line) before the tunnel.
source "$(dirname "${BASH_SOURCE[0]}")/rl_run.coupled-read.env"
INFER_GPUS=3,4  # 10-22: GPUs 0-2 were in use
TRAIN_GPUS=
PORT0=30800
TRAINER_SSH=user@10.0.1.94
SSH_RPORT=2238
