# SWE RL pilot (user, 10-22): rl_run.coupled.env's training on coupled-a-train (R = 2y-1) with the read tool on
# (OCTOPUS_READ_TOOL=1; OCTOPUS_AUTO_FORK, OCTOPUS_READ_EVENT and OCTOPUS_READ_CONTROL stay unset), main's call cap 200 and
# every thread's growth cap 64K, as planned for node-94 (servers on its GPUs 0-2 and node-136's 3-4: REMOTE,
# rl_run.coupled-read.136.env; training on 3-7). Never launched: the pilot and its full run (36 steps) were launched on Cluster
# Alpha from scripts/alpha/rl_run.env, derived from this file (no REMOTE; Alpha's GPUs and backend). Kept as the lab-host (node-94 + node-136) form of that config.
source "$(dirname "${BASH_SOURCE[0]}")/rl_run.coupled.env"
STATE=$OCTO_ENV/rl-state-coupled-read
ROLLOUT_SPOOL=$STATE/spool
STEPS=15
EPISODES_PER_SERVER=5  # 5 servers (94: 0-2, 136: 3-4), every episode's containers on node-94's 32 cores
export OCTOPUS_READ_TOOL=1 OCTOPUS_THREAD_BUDGET=65536 OCTOPUS_MAIN_MAX_CALLS=200
REMOTE="user@127.0.0.1:2238"  # node-136's sshd through its `rl_run.sh tunnel`
REMOTE_ENV=$CODE/scripts/rl_env/rl_run.coupled-read.136.env
