# RL_ENV_FILE of Search v5 on Cluster Beta (aarch64 Grace + GB200; stack: scripts/beta/install_env.sh): Alpha's
# Search baseline settings (scripts/alpha/search.env, its paths relative to this code dir: ROOT = .../beta/octopus,
# models and search data linked to Alpha's) and the full run's BATCH=16 SAVE_EVERY=10 (tasks/search-full.sh); credit as
# Alpha's (outcome; search_v5.sh adds its rl.branch_credit=gate).
BATCH=${BATCH:-16} SAVE_EVERY=${SAVE_EVERY:-10}
source "$(dirname "${BASH_SOURCE[0]}")/../alpha/search.env"
CUDA_HOME=$OCTO_ENV/cuda-13.0  # SGLang's JIT kernels: Alpha's /usr/local/cuda is the same nvcc 13.0.88 (install_env.sh)
export TRITON_CACHE_DIR=$OCTO_ENV/cache/triton  # aarch64's own (the shared home's profile points at Alpha's)
EXTRA="$EXTRA${EXTRA_ADD:+ $EXTRA_ADD}"  # EXTRA_ADD: search_v5.sh's (rl_run.sh sources this file again)
