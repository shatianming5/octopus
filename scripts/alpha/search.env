# RL_ENV_FILE of the Search RL pilot on Cluster Alpha (user, 10-22; scripts/alpha/search.sbatch): scripts/rl_env/rl_run.search.env
# with this deployment's paths (ROOT as in rl_run.env, this file = ROOT/code-SHA/scripts/alpha/search.env): OpenResearcher
# train (HF Tommysha/octopus-train branch `search`, deploy.sh fetch --search -> ROOT/search-data), pure outcome
# R = 2y-1 with the judge (JUDGE_MODEL; Qwen3.5-27B at temperature 0 since the CLM settings, Qwen3-32B before), OCTOPUS_READ_TOOL=1 (AUTO_FORK, READ_EVENT, READ_CONTROL unset), OCTOPUS_REWIND_TOOL=1
# (scripts/rl_env/rl_run.search.env does not set it), 15 steps (the gate) or 190 (the full run, below).
# GPUs (search.sbatch sets them from Slurm's allocation, 4 of an H200 node): judge | 2 rollout | 1 training.
#  - judge: Qwen3.5-27B bf16 is ~54 GB of weights (Qwen3-32B's 65 GB held ~50 GB of KV), one H200 (141 GB); one judge call per
#    episode that does not exact-match, 4096 tokens at most;
#  - rollout: the node-138 trial saturated one A6000 at EPISODES_PER_SERVER=16 (900 s timeouts); an H200 has ~3x its KV pool and ~5x
#    its memory bandwidth. Units: EPISODES_PER_SERVER counts groups (8 episodes each). Measured on Alpha (10-23, run record
#    results/alpha-search-read-1022): 16 per server = 16 groups = 128 episodes per server: 76 groups rejected in 88 min; 8
#    per server = 64 episodes per server: 1 group rejected in 65 min (stable).
#  - training: one H200 for the 4B rank-64 LoRA (node-138 trained it on one A6000).
# Its own dirs (ROOT/search) and ports (32xxx; the SWE pilot uses 30300/31300), so both pilots can share a node.
OCTO_ENV=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
CODE=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
CURSOR=$OCTO_ENV/cursor-${CODE##*/code-}
AREAL_PY=$OCTO_ENV/areal/.venv/bin/python
SGLANG_PY=$OCTO_ENV/sglang-venv/bin/python
MODEL_TEXT=$OCTO_ENV/models/Qwen3.5-4B-text
MODEL_VL=$OCTO_ENV/models/Qwen3.5-4B
ADAPTER0=$OCTO_ENV/models/adapter-v0-4b-text-r64
JUDGE_MODEL=$OCTO_ENV/models/Qwen3.5-27B-text  # text-only (octopus.rl.text_checkpoint of Qwen/Qwen3.5-27B): with the judge's flags SGLang serves the VL checkpoint through qwen3_vl and crashes on its startup warmup
SEARCH_DATA=$OCTO_ENV/search-data
FILEROOT=$OCTO_ENV/search/areal-exp
STATE=$OCTO_ENV/search/rl-state-search
JOBS_ROOT=$OCTO_ENV/search/rl
PILOT=$OCTO_ENV/search/pilot
INFER_GPUS=${INFER_GPUS-1,2}  # set but empty: no local servers (all rollout on EXTRA_SERVERS, rl_run.sh)
TRAIN_GPUS=${TRAIN_GPUS-3}
JUDGE_GPU=${JUDGE_GPU:-0}
# JUDGE_HOST (a host setting, as OCTOPUS_JUDGE_URL): the judge on another job's node (lib.sh serve_rollout ... judge, at its
# SERVE_HOST), so search.sbatch starts none and trains on its GPU too; unset: search.sbatch's own judge on JUDGE_GPU
PORT0=32300 PORT_BASE=32400 JUDGE_PORT=32500 SEARCH_PORT=32600
STEPS=${STEPS:-15}  # lib.sh train_to N passes STEPS=N
# questions per step (BATCH, x 8 samples) and the adapter save interval: the full run (user, 10-22) is BATCH=16 STEPS=190
# SAVE_EVERY=10: 3040 train questions / 16 = 190 steps, one epoch (AReaL's dataloader drops a last partial batch)
EXCLUDE=""
MEM_MAX=job
CUDA_HOME=/usr/local/cuda
EPISODES_PER_SERVER=${EPISODES_PER_SERVER:-16}  # the queue task sets it (04: 8 per rollout server, 10-23 restart)
# a new episode goes to the server with the fewest requests in flight; a proxy worker (one per server) admits a new
# episode only while one server has fewer than ROUTE_CAP of ITS requests in flight (octopus/serving/route.py; follow-up
# requests uncapped, other workers' load unseen: no bound on a server's total). search-v6c-1024 step 23 (forks at 60%):
# one server at 117 in flight (KV 0.96, 900 s timeouts) while three held ~10, 123 in all
ROUTE_CAP=${ROUTE_CAP:-16}
# KV-aware admission (docs/search-env.md "Admission", host settings, so a resume or an eval may change them): a new
# episode starts only on a server whose SGLang KV usage is below OCTOPUS_ROUTE_KV with no queued request, else it waits,
# at most OCTOPUS_ROUTE_WAIT s (then a server under the cap takes it; well below the episodes' 900 s HTTP timeout, which
# the wait spends). Of the open servers a random draw weighted by free tokens below the target picks one. With it EPISODES_PER_SERVER and search_eval.sh's EVAL_PARALLEL are upper bounds (v7: fixed 16 groups
# per server saturated KV at 0.95-0.98; evals at a fixed 16 sat at KV ~0.2). OCTOPUS_ROUTE_KV=0: off (in-flight counts)
export OCTOPUS_ROUTE_KV=${OCTOPUS_ROUTE_KV-0.75} OCTOPUS_ROUTE_WAIT=${OCTOPUS_ROUTE_WAIT-300}
# Optional OCTOPUS_ROUTE_TREE_TOKENS (tokens; unset = off): a server holds at most max(1, KV x pool / it) active episode
# trees, counted over every router on the host, since KV shows an episode only as it grows (docs/search-env.md "Admission")
OFFPOLICY=2
LORA_RANK=64
LORA_KEEP=40  # v8: a long episode outlived 10 adapter versions and the unload of rq1-v0 hung
MEM_FRAC=0.88
MB_TOKENS=262144
export OCTOPUS_HARBOR=$OCTO_ENV/harbor OCTOPUS_CODE=$CODE OCTOPUS_SEARCH_PYTHON=$OCTO_ENV/harbor-venv/bin/python
export OCTOPUS_SEARCH_URL=http://127.0.0.1:$SEARCH_PORT
export OCTOPUS_READ_TOOL=1
# rewind (history only, docs/search-env.md "Rewind") in every search run of this file, fork and linear arms alike (the
# runtime's default stays off; SWE env files do not set it)
export OCTOPUS_REWIND_TOOL=1
# at most 2 rewinds a thread (docs/search-env.md "Rewind"): uncapped, search-v6-1024 doubled its step time for no accuracy
export OCTOPUS_REWIND_MAX=2
export OCTOPUS_JUDGE_URL=http://${JUDGE_HOST:-127.0.0.1}:$JUDGE_PORT/v1 OCTOPUS_JUDGE_MODEL=judge OCTOPUS_JUDGE_TIMEOUT=120 OCTOPUS_JUDGE_CACHE=$STATE/judge-cache.jsonl
export LITELLM_LOCAL_MODEL_COST_MAP=True HF_HOME=$OCTO_ENV/cache/hf
# NCCL picks InfiniBand for training ranks of one node (rl_run.sh disables P2P) and the loopback QP times out
# (ibv_modify_qp 110 on mlx5_4, job 144123): with TRAIN_GPUS of more than one GPU, no IB
export NCCL_IB_DISABLE=1
# rollout servers in another job read each adapter from FILEROOT over NFS: the trainer must not remove them (train.py)
[ -z "${EXTRA_SERVERS:-}" ] || export OCTOPUS_KEEP_WEIGHT_UPDATES=1
export SGLANG_ENABLE_JIT_DEEPGEMM=0  # sm90: the pinned deep_gemm lacks the API SGLang imports (scripts/nvwulf/env.sh)
EXTRA="workflow=octopus.envs.search.rl.SearchEpisodeAgent rl.search_questions=$SEARCH_DATA/search/openresearcher-questions.jsonl rl.search_split=$SEARCH_DATA/search/train-qids.txt gconfig.n_samples=8 train_dataset.batch_size=${BATCH:-8} saver.freq_steps=${SAVE_EVERY:-5} recover.freq_steps=1"
