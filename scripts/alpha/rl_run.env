# RL_ENV_FILE on Cluster Alpha (alpha1, Slurm; 4 of an alpha node's 8 H200, scripts/alpha/pilot.sbatch): the SWE RL
# pilot (user, 10-22) = PR #238's rl_run.coupled-read.env without its node-136 REMOTE: rl_run.coupled.env's training on
# coupled-a-train (R = 2y-1) with OCTOPUS_READ_TOOL=1 (OCTOPUS_AUTO_FORK, READ_EVENT and READ_CONTROL unset), main's call cap
# 200 and every thread's growth cap 64K; 15 steps for the gate, 36 for the full run (below).
# Deployment (scripts/deploy.sh ROOT fetch + install, ROOT = /projects/cluster/octopus/octopus):
# this file is ROOT/code-SHA/scripts/alpha/rl_run.env. Containers: Alpha has no Docker and /projects is NFS, so the
# episodes use the Singularity backend (octopus/envs/swe/singularity.py, as NVwulf): one SIF per image in ROOT/sif
# (scripts/nvwulf/pull_sifs.sh), each trial's writable copy in /dev/shm.
OCTO_ENV=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)
export OCTOPUS_HARBOR=$OCTO_ENV/harbor
IG=${INFER_GPUS-0,1} TG=${TRAIN_GPUS:-2,3} ST=${STEPS:-15} EP=${EPISODES_PER_SERVER:-16}  # rl_run.coupled.env sets node-94's
source "$(dirname "${BASH_SOURCE[0]}")/../rl_env/rl_run.coupled.env"
# this pilot's own dirs (the Search pilot, search.env, has ROOT/search): AReaL fileroot, state, episodes, pilot.sbatch's results
FILEROOT=$OCTO_ENV/swe/areal-exp
STATE=$OCTO_ENV/swe/rl-state-coupled-read
ROLLOUT_SPOOL=$STATE/spool
JOBS_ROOT=$OCTO_ENV/swe/rl
PILOT=$OCTO_ENV/swe/pilot
STEPS=$ST  # lib.sh train_to N passes STEPS=N
export OCTOPUS_READ_TOOL=1 OCTOPUS_THREAD_BUDGET=65536 OCTOPUS_MAIN_MAX_CALLS=200
# bundles per step (BATCH, x 8 samples; rl_run.coupled.env's 4) and the adapter save interval (grpo.yaml's 5; a last step off
# it gets no adapter): the full run (user, 10-22) is BATCH=8 STEPS=36 SAVE_EVERY=6: 290 train bundles / 8 = 36 steps, one
# epoch less 2 bundles (AReaL's dataloader drops a last partial batch; a 37th step would start the next shuffled epoch)
EXTRA=${EXTRA/train_dataset.batch_size=4/train_dataset.batch_size=${BATCH:-4}}${SAVE_EVERY:+ saver.freq_steps=$SAVE_EVERY}${BRANCH_CREDIT:+ rl.branch_credit=$BRANCH_CREDIT}  # BRANCH_CREDIT=gate: v5 (octopus/rl/group.py)
# 2 SGLang rollout + 2 FSDP training GPUs (pilot.sbatch sets these from Slurm's allocation). node-94's e14 was
# training-bound on 5 RTX 4090D (rollout wait ~0 s, train_step + recompute_logp ~13 min a step) with 8 rollout servers
# (94 + 136) keeping up; two H200s decode about as fast as those 8, and two train faster than the 5.
INFER_GPUS=$IG
TRAIN_GPUS=$TG
EPISODES_PER_SERVER=$EP  # 16: 32 concurrent episodes (one step's batch) on 2 servers; an H200's KV pool is ~3x a 48 GB card's
MEM_MAX=job  # no user systemd in a Slurm job: the job's cgroup is the cap
CUDA_HOME=/usr/local/cuda  # its version differs by node (login 12.6, cpu node 13.0); SGLang here JIT-compiles nothing with it
export OCTOPUS_EPISODE_MEM=  # same reason: episodes run without their own systemd scope
export OCTOPUS_HARBOR_ENV=octopus.envs.swe.singularity:SingularityEnvironment SINGULARITY_TRIAL_OVERLAY=1
export SINGULARITY_SIF_DIR=$OCTO_ENV/sif SINGULARITY_TRIALS_DIR=/dev/shm
export PATH=$OCTO_ENV/apptainer/bin:/cm/local/apps/apptainer/current/bin:$PATH
export LITELLM_LOCAL_MODEL_COST_MAP=True
# NCCL picks InfiniBand for two ranks of one node (rl_run.sh disables P2P) and the loopback QP times out
# (ibv_modify_qp 110 on mlx5_4, job 144123): the trainer is single-node, so no IB
export NCCL_IB_DISABLE=1
# rollout servers in other jobs (EXTRA_SERVERS, INFER_GPUS set but empty) read each adapter from FILEROOT over NFS: the
# trainer must keep them (octopus/rl/train.py keep_weight_updates)
[ -z "${EXTRA_SERVERS:-}" ] || export OCTOPUS_KEEP_WEIGHT_UPDATES=1
# SGLang turns on JIT DeepGEMM on sm90, and the pinned deep_gemm lacks the API it imports (scripts/nvwulf/env.sh)
export SGLANG_ENABLE_JIT_DEEPGEMM=0
