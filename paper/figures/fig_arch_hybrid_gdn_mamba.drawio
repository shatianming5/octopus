<mxCell id="hb_mscan" value="&lt;b style=&quot;font-size:11.5px;color:#1E3A8A;&quot;&gt;Mamba-2 SSD Chunk Scan → fla chunk_simple_gla (tree_recurrence)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#0F172A;&quot;&gt;• &lt;b&gt;Exact SSD-to-GLA Mapping:&lt;/b&gt; q = repeat(C), k = repeat(B), v = dt · x, decay g = A · dt + skip D · x&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#0F766E;&quot;&gt;• &lt;b&gt;Tree State:&lt;/b&gt; Starts from parent SSM state &lt;b&gt;h&lt;sub&gt;parent&lt;/sub&gt;&lt;/b&gt; on fork/rewind; &lt;/font&gt;&lt;font style=&quot;font-size:10px;color:#DC2626;&quot;&gt;&lt;b&gt;[✗ Skips Mounted KV Spans]&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=16;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=1.8;fontFamily=Helvetica;fontSize=10.5;fontColor=#1E3A8A;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="946" y="658" width="598" height="66" as="geometry"/></mxCell>
