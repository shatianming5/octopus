<mxCell id="hb_mhook_note" value="&lt;b style=&quot;color:#064E3B;&quot;&gt;Why patch_mamba2 Routes to fla chunk_simple_gla:&lt;/b&gt; Stock HF torch fallback ignores &lt;code&gt;cu_seq_lens_q&lt;/code&gt; and lacks per-node initial states; our SSD-to-GLA tree kernel guarantees &lt;b&gt;100% bit-exact branch isolation&lt;/b&gt;." style="rounded=1;arcSize=18;fillColor=#CCFBF1;strokeColor=#0F766E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.0;fontColor=#064E3B;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="942" y="898" width="606" height="42" as="geometry"/></mxCell>
