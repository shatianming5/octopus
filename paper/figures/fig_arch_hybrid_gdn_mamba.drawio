<mxCell id="hb_mconv" value="&lt;b&gt;Causal Conv1d + SiLU on [x, B, C] (tree_conv)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Gathers &lt;b&gt;CONV_CONTEXT = mamba_d_conv − 1&lt;/b&gt; Ancestor Tokens!&lt;/font&gt;" style="rounded=1;arcSize=24;fillColor=#FCE7F3;strokeColor=#9D174D;strokeWidth=1.6;fontFamily=Helvetica;fontSize=10.5;fontColor=#831843;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="952" y="748" width="290" height="42" as="geometry"/></mxCell>
