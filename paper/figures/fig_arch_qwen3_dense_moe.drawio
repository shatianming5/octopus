<mxCell id="db_hk_hdr" value="&lt;b style=&quot;font-size:13px;color:#064E3B;&quot;&gt;How Qwen3 (MoE) Hooks into Octopus (Stateless Expert Scaling)&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=13.5;fontColor=#0F172A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="944" y="820" width="610" height="22" as="geometry"/></mxCell>
<mxCell id="db_hk_b1" value="• &lt;b&gt;Zero MoE State on fork / rewind / read_thread:&lt;/b&gt; Top-K routing is strictly token-wise and stateless across time; branching &amp; KV mounting operate purely on the &lt;b&gt;Attention Radix Cache&lt;/b&gt; with 0 expert state copies." style="rounded=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.5;fontColor=#064E3B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="942" y="844" width="614" height="40" as="geometry"/></mxCell>
<mxCell id="db_hk_b2" value="• &lt;b&gt;High-Density Grouped GEMM on Parallel Branches:&lt;/b&gt; Spawning W parallel branches and packing deduplicated &lt;code&gt;T_tree&lt;/code&gt; tokens turns memory-bound single-branch expert calls into high-utilization batched H200 GEMMs." style="rounded=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.5;fontColor=#064E3B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="942" y="888" width="614" height="40" as="geometry"/></mxCell>
<mxCell id="db_hk_b3" value="• &lt;b&gt;Router-Preserving LoRA Adaptation:&lt;/b&gt; Adapts attention projections (&lt;code&gt;q/k/v/o_proj&lt;/code&gt;) while keeping Top-K router logits &amp; expert balance unperturbed during multi-branch DAG-GRPO reinforcement learning." style="rounded=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.5;fontColor=#064E3B;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="942" y="932" width="614" height="36" as="geometry"/></mxCell>
