# bundle-e2b (2026-10-11): bundle-e2 settings (fresh from base, PR #53, 8 x 4, 53 steps) with 12 rollout servers:
# node-94 4 FSDP train ranks (GPUs 4-7) + 4 SGLang (0-3); node-183 8 SGLang (GPUs 2-9) through its reverse tunnels (2235, 30400-30407).
# node-134 GPUs 4-7 run the eval. All SGLang venvs carry patches/apply_sglang_lora_abort_release.py.
AREAL_PY=/mnt/disk1/user/areal/.venv/bin/python
SGLANG_PY=/mnt/disk1/user/sglang-4090d/bin/python
CODE=/home/user/harbor-udocker/code-73b0f67
MODEL_TEXT=/mnt/disk1/user/models/Qwen3.5-4B-text
MODEL_VL=/mnt/disk1/user/models/Qwen3.5-4B
ADAPTER0=/mnt/disk1/user/models/adapter-v0-4b-text-r64
FILEROOT=/home/user/areal-exp  # exists on node-183 too (adapter push goes to the same path)
STATE=/home/user/octopus-sft/rl-state-bundle-e2b
INFER_GPUS=0,1,2,3
TRAIN_GPUS=4,5,6,7
STEPS=53
EXCLUDE=/home/user/harbor-udocker/rl/exclude-bundle-empty.txt
MEM_MAX=400G
CUDA_HOME=/usr/local/cuda-12.2
EPISODES_PER_SERVER=8
OFFPOLICY=2
LORA_RANK=64
LORA_KEEP=10
MEM_FRAC=0.88
export OCTOPUS_BUNDLE=1 OCTOPUS_FORK_OPTIONAL=1 OCTOPUS_CODE=/home/user/harbor-udocker/code-73b0f67 GROK_HARBOR_MAX_STEPS=200
EXTRA="gconfig.n_samples=4 train_dataset.batch_size=8 rl.pool=/home/user/harbor-udocker/rl/empty-pool.jsonl rl.plan_tasks=/home/user/harbor-udocker/rl/bundle-e1-82b-tasks.txt saver.freq_steps=5 recover.freq_steps=1 rollout.request_timeout=21600"
AREAL_OVERLAY=/home/user/octopus-sft/areal-overlay-b543b  # PR #45: overlay ahead of CODE on PYTHONPATH (logprobs patch)
REMOTE=user@127.0.0.1:2235  # node-183 sshd through its reverse tunnel
REMOTE_ENV=/mnt/ssd1/user/rl-remote/rl_run.env
