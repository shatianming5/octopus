# bundle-e9 (2026-10-14): bundle-e8f science and layout + PR #69 (DP balance: plan episodes dispatched to FSDP ranks one by one by prefix-tree tokens, largest-first micro-batches) + PR #70 (OCTOPUS_ABORT_SOLVABLE=0.5: a bundle abort of a task the group solved costs 0.5). Code code-e376694 (main f28550d). 53 steps from base (ADAPTER0), bundle-e8-tasks, TOKEN_PRICE 0.5, FORK_TASK_COEF 1, CHECK_COEF 0.5, recompute on.
# Layout: node-94 GPUs 3-7 = 5 FSDP ranks (MB_TOKENS 262144), GPUs 0-2 = 3 local SGLang; node-138 GPUs 0-4 A6000 = 5 remote SGLang (direct LAN ssh 10.0.1.138:22). 8 servers x EPISODES_PER_SERVER 6 = 48 episode slots.
AREAL_PY=/mnt/disk1/user/areal/.venv/bin/python
SGLANG_PY=/mnt/disk1/user/sglang-4090d/bin/python
CODE=/home/user/harbor-udocker/code-e376694
MODEL_TEXT=/mnt/disk1/user/models/Qwen3.5-4B-text
MODEL_VL=/mnt/disk1/user/models/Qwen3.5-4B
ADAPTER0=/mnt/disk1/user/models/adapter-v0-4b-text-r64
FILEROOT=/home/user/areal-exp  # exists on node-183 too (adapter push goes to the same path)
STATE=/home/user/octopus-sft/rl-state-bundle-e9
INFER_GPUS=  # 2026-10-15: node-94 all training; rollout on remote servers only
TRAIN_GPUS=0,1,2,3,4,5,6,7
STEPS=53
EXCLUDE=/home/user/harbor-udocker/rl/exclude-bundle-empty.txt
MEM_MAX=420G  # 2026-10-15: no local SGLang on node-94 after the 8-rank change (host 503 GB; episodes ~60-70 GB)
CUDA_HOME=/usr/local/cuda-12.2
EPISODES_PER_SERVER=8  # cap; live.env sets the running value (15 servers)
OFFPOLICY=2
LORA_RANK=64
LORA_KEEP=10
MEM_FRAC=0.88
MB_TOKENS=262144  # 2026-10-14: was 131072 (22-25 GB VRAM used). Host anon tracks the per-rank batch share, not the micro-batch (3 ranks x 76 GB at 262144 ~ 8 ranks x 24 GB at 131072); yaml default 262144 left ~5 GB VRAM on 3 ranks. User: use node-94 VRAM fully. Watchdog cuts 10% on OOM or host > 385G
export OCTOPUS_BUNDLE=1 OCTOPUS_FORK_OPTIONAL=1 OCTOPUS_CODE=/home/user/harbor-udocker/code-e376694 GROK_HARBOR_MAX_STEPS=120 OCTOPUS_CHECK_COEF=0.5 OCTOPUS_TOKEN_PRICE=0.5 OCTOPUS_FORK_TASK_COEF=1 OCTOPUS_ABORT_SOLVABLE=0.5
EXTRA="gconfig.n_samples=4 train_dataset.batch_size=8 rl.pool=/home/user/harbor-udocker/rl/empty-pool.jsonl rl.plan_tasks=/home/user/harbor-udocker/rl/bundle-e8-tasks.txt saver.freq_steps=5 recover.freq_steps=1 rollout.request_timeout=21600"
AREAL_OVERLAY=/home/user/octopus-sft/areal-overlay-b543b  # PR #45: overlay ahead of CODE on PYTHONPATH (logprobs patch)
#REMOTE="user@10.0.1.138:22"  # 2026-10-15 20:02: node-138 GPUs 0,1,2,4 taken by haibo; rollout on node-94 only
REMOTE="user@127.0.0.1:2238 user@127.0.0.1:2239 user@127.0.0.1:2237"  # 2026-10-16 01:2x: node-138 GPU fault, dropped  # 2026-10-15 22:0x: node-138 GPU 3 (direct), node-136 (2238), node-68 (2239)
REMOTE_ENV=/home/user/rl-remote/rl_run.env  # same path on all three (node-183: = /mnt/ssd1/user/rl-remote/rl_run.env)
MB_TOKENS=196608  # coordinator 2026-10-15: pinned host activations of 5 ranks peaked at 399G of MEM_MAX 400G with 262144
ROLLOUT_SPOOL=/home/user/octopus-sft/rl-state-bundle-e9/spool  # PR #77: finished untrained groups survive a resume
MB_TOKENS=131072  # 8 training ranks (pinned host activations scale with ranks x micro-batch)
