# bundle-e1d on two machines (2026-10-10): node-94 4 FSDP train ranks (GPUs 4-7) + 4 SGLang (0-3); node-134 7 SGLang (GPUs 0,2-7)
# through its reverse tunnels (on node-134: RL_ENV_FILE=/mnt/disk4/user/rl-remote/rl_run.env rl_run.sh tunnel).
# 4 not 5 train ranks: the 3-rank peak was shmem 222G + anon 42G (74G pinned per rank); 5 ranks ~430G > 503G - others.
# Code main + remote rollout (code-ebd1c56). Resumes trial bundle-e1d from its recover checkpoint (DCP, resharded 3 -> 4).
AREAL_PY=/mnt/disk1/user/areal/.venv/bin/python
SGLANG_PY=/mnt/disk1/user/sglang-4090d/bin/python
CODE=/home/user/harbor-udocker/code-8d3c7eb
MODEL_TEXT=/mnt/disk1/user/models/Qwen3.5-4B-text
MODEL_VL=/mnt/disk1/user/models/Qwen3.5-4B
ADAPTER0=/mnt/disk1/user/models/adapter-v0-4b-text-r64
FILEROOT=/mnt/disk1/user/areal-exp
STATE=/home/user/octopus-sft/rl-state-bundle-e1d
INFER_GPUS=0,1,2,3
TRAIN_GPUS=4,5,6,7
STEPS=54
EXCLUDE=/home/user/harbor-udocker/rl/exclude-bundle-empty.txt
MEM_MAX=400G
CUDA_HOME=/usr/local/cuda-12.2
EPISODES_PER_SERVER=8
OFFPOLICY=2
LORA_RANK=64
LORA_KEEP=10
MEM_FRAC=0.88
export OCTOPUS_BUNDLE=1 OCTOPUS_FORK_OPTIONAL=1 OCTOPUS_CODE=/home/user/harbor-udocker/code-8d3c7eb GROK_HARBOR_MAX_STEPS=200
EXTRA="gconfig.n_samples=4 train_dataset.batch_size=8 rl.pool=/home/user/harbor-udocker/rl/empty-pool.jsonl rl.plan_tasks=/home/user/harbor-udocker/rl/bundle-e1-82b-tasks.txt saver.freq_steps=5 recover.freq_steps=1 rollout.request_timeout=21600"
AREAL_OVERLAY=/home/user/octopus-sft/areal-overlay-b543b  # PR #45: overlay ahead of CODE on PYTHONPATH (logprobs patch)
REMOTE=user@127.0.0.1:2234  # node-134 sshd through its reverse tunnel
REMOTE_ENV=/mnt/disk4/user/rl-remote/rl_run.env
