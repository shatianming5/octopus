# newhost.sh settings for node-134 (8x RTX 4090D 48 GB, 503 GB RAM, PCIe; lab host, user user), 10-30 resume:
# TRAIN_GPUS=... ROLLOUTS=... NEWHOST_ENV=$PWD/newhost-134.env bash newhost.sh CMD. GPUs chosen at
# launch among the cards with room (never 5) (README "node-134 (10-30)"); the judge runs on node-67. Venvs: node-134's ~/octo-env ones, updated by scripts/nvwulf/install_env.sh (README).
# /home paths: the same on node-68 (remote rollouts: their adapter pushes go to the same FILEROOT path there); on node-134
# ROOT is a symlink to /mnt/disk4/user/search-v9-134 and ~/octo-env one to /mnt/disk4/user/octo-env-data
ROOT=/home/user/search-v9-134
O=/home/user/octo-env
AREAL_PY=$O/areal/.venv/bin/python
SGLANG_PY=$O/sglang-venv/bin/python     # sglang 0.5.19, torch 2.8.0+cu128
CURSOR=$ROOT/cursor                     # install_env.sh's overlay: areal/ and sglang/
HARBOR=/home/user/harbor-udocker
SEARCH_PY=/home/user/harbor-udocker/uv-tools/harbor/bin/python  # Harbor 0.23.0, as node-138
CU=/usr/local/cuda-12.9
export TMPDIR=/mnt/disk4/user/tmp  # the root fs is full: nvcc fails in /tmp
MODEL_VL=$O/models/Qwen3.5-4B
MODEL_TEXT=$O/models/Qwen3.5-4B-text
JUDGE_MODEL=                            # judge on node-67
FILEROOT=$ROOT/run                      # checkpoint: $FILEROOT/checkpoints/user/rq1-rl/search-v9-rest (HF octopus-org/search-v9-ckpt)
SEARCH_ROOT=$ROOT/search                # datasets -> $O/datasets; search-scratch/openresearcher built with tantivy 0.27.0
TOKENIZER=/mnt/disk4/user/search-v9/hf/search-v9-runtime/Qwen3-0.6B-tokenizer
QUESTIONS=$O/search/openresearcher-questions.jsonl  # md5 dcadeb557f32d4dcf75f195d1c0ce402
SPLIT=$ROOT/data/rest2-qids.txt         # node-138's, md5 abb8f1a678c7cf10fda3916785c763ec
RUN=$ROOT/run
SPOOL_REPO=octopus-org/search-v9-ckpt

# layout, given at launch: GPU 5 is another project's (same account), never ours
TRAIN_GPUS=${TRAIN_GPUS:?TRAIN_GPUS=a,b: the trainer cards, fsdp d = their number (README "node-134 (10-30)")}
ROLLOUTS=${ROLLOUTS:?ROLLOUTS=gpu:port ...: one 4B server per card, ports from 32310 (README "node-134 (10-30)")}
case ",$TRAIN_GPUS,$(for pg in $ROLLOUTS; do printf '%s,' "${pg%:*}"; done)" in *,5,*) echo "node-134 GPU 5 is not ours"; exit 1;; esac
# remote rollouts: node-68 (user@10.0.1.68:GPU:PORT, ports from 32320) GPUs 0, 1 and 4 only (user, 10-30), CUDA 12.4
for pg in $ROLLOUTS; do case $pg in [0-9]:*|user@10.0.1.68:[014]:*) ;; *) echo "$pg: node-68 GPUs 0, 1, 4 only"; exit 1;; esac; done
R_CU=/usr/local/cuda-12.4
JUDGE_GPUS=
JUDGE_MEM=
JUDGE_MAMBA_SLOTS=
# shared cards (user2): newhost.sh starts on a card only with its need + 6 GiB free, a rollout server at all the free
# memory but 6.5 GiB (serve_f2.sh BUDGET); README "node-134 (10-30)"
SHARED=1
TRAIN_MIB=36864                         # the trainer's GPU peak per card: 35.4 GiB measured (docs/trainer-memory.md, chunk-major, 32K chunks)
ROLLOUT_MIB=12288                       # a rollout server's floor: 8.6 GB weights + ~3 GB runtime (no KV pool below it)
JUDGE_URL=http://10.0.2.167:32500/v1 # judge-67's server on node-67 (start_judge.sh JUDGE_GPUS; 10-30: 0,1)
EXTRA_SERVERS=
ADAPTER_PUSH=
RELEASE=$K/newhost-134.release         # the node-67 judge

# trainer
MB_TOKENS=65536
CHUNK_MAJOR=1
CHUNK_TOKENS=32768
NCCL_P2P_DISABLE=1                      # PCIe 4090Ds (node-138's PCIe A6000s ran 1)

# admission: CONCURRENT ~ the servers' pools in all / 684K (a whole 4090D's at 0.88). A shared card's pool is smaller:
# after `serve`, sum max_total_num_tokens over $RUN/logs/rollout-g*.log. Default: one per server (whole-card pools)
CONCURRENT=${CONCURRENT:-$(wc -w <<< "$ROLLOUTS")}
ROUTE_KV=0.5 ROUTE_CAP=16 ROUTE_WAIT=800
ROUTE_TREE_TOKENS=40000
