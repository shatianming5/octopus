# newhost.sh settings for the 10-29 host ubuntu@198.51.100.11 (8x A100-SXM4-80GB, 1.7 TB RAM, NVLink): every path is
# the one the deploy agents (deploy-env, deploy-models, deploy-search) were asked for; `newhost.sh preflight` names any
# that differs. README "New host (10-29)".
ROOT=/home/ubuntu/octo
# deploy-env: provision_newhost.sh venvs (scripts/nvwulf/install_env.sh, ROOT venvs/): the trainer and SGLang venvs and
# the AReaL + SGLang cursor overlay; deploy-harbor: Harbor (search agent)
AREAL_PY=$ROOT/venvs/areal/.venv/bin/python
SGLANG_PY=$ROOT/venvs/sglang/bin/python   # sglang 0.5.19, torch 2.8.0+cu128
CURSOR=$ROOT/venvs/cursor          # holds areal/ (5 AReaL patches) and sglang/ (cursor + mount patches)
HARBOR=$ROOT/harbor                # deploy-harbor: scripts/env.sh (sourced by every search episode), bin/harbor
SEARCH_PY=$ROOT/harbor-venv/bin/python  # runs octopus.envs.search.agent (imports harbor; Harbor 0.23.0); must be explicit:
                                   # bin/harbor is a symlink, so the default (python beside it) does not exist
CU=/usr/lib/cuda                   # CUDA 12.8 nvcc (SGLang's JIT kernels; verified by deploy-sglang)
export TMPDIR=$ROOT/tmp
# deploy-models (FILEROOT: checkpoints/ubuntu/rq1-rl/search-v9-rest is a symlink to checkpoints/rq1-rl/search-v9-rest)
MODEL_VL=$ROOT/models/Qwen3.5-4B   # the rollout servers serve the vision-language checkpoint (octopus/rl/text_checkpoint.py): -text with LoRA fails (get_hidden_dim not implemented for in_proj_qkvz)
MODEL_TEXT=$ROOT/models/Qwen3.5-4B-text
JUDGE_MODEL=$ROOT/models/Qwen3.5-27B-text
FILEROOT=$ROOT/run                 # the checkpoint must be at $FILEROOT/checkpoints/$(id -un)/rq1-rl/search-v9-rest (AReaL's path)
# deploy-search
SEARCH_ROOT=$ROOT/data/search      # holds search-scratch/openresearcher (docs.arrow + bm25/)
TOKENIZER=$ROOT/data/search/Qwen3-0.6B-tokenizer   # the snippet tokenizer
QUESTIONS=$ROOT/data/search/questions/openresearcher-questions.jsonl  # node-138's file, md5 dcadeb557f32d4dcf75f195d1c0ce402
SPLIT=$ROOT/data/search/questions/rest2-qids.txt             # node-138's file, md5 abb8f1a678c7cf10fda3916785c763ec (281 qids)
# run state written here: logs, pid files, jobs, spool, live.env, admin_api_key (mode 600, made by the first `train`)
RUN=$ROOT/run
SPOOL_REPO=octopus-org/search-v9-ckpt  # private HF model repo, its spool/ (README "Archive on HF (10-30)")

# layout (README "New host (10-29)")
TRAIN_GPUS=0,1,2,3          # fsdp d = number of GPUs (DCP reshards the checkpoint's shards: 4 in gen41, 3 in gen42)
JUDGE_GPUS=4                # Qwen3.5-27B-text at tp = number of GPUs (tp1 at 0.88, measured: 50.2 GB weights; with
                            # JUDGE_MAMBA_SLOTS=100 ~14 GiB of mamba state, ~80K KV tokens, 20 running); empty: JUDGE_URL elsewhere
JUDGE_MEM=0.88
# Mamba state slots of the judge (--max-mamba-cache-size); they come out of the 0.88 pool first, KV gets the rest.
# Smoke test (tp1, 0.88): 62 slots (8.86 GiB, 144 MiB each), KV 165,375 tokens (64 KiB each: 16 attention layers x 4 KV
# heads x 256 x 2 x bf16), max_running_requests capped at 62 // 5 = 12. With 100: 14.5 GiB of slots, ~4.6 GiB KV
# (~76K tokens, ~3.8K per running request; a grader prompt is ~1-2K), 20 running. 120 would leave ~29K tokens for 24.
JUDGE_MAMBA_SLOTS=100
ROLLOUTS="5:32310 6:32311 7:32312"  # gpu:port, one 4B server per card (0.88: ~1.3M-token pool, estimate)
JUDGE_URL=http://127.0.0.1:32500/v1
EXTRA_SERVERS=              # more rollout servers host:port,... (same overlay; their hosts need ADAPTER_PUSH)
ADAPTER_PUSH=               # "user@host:22 ..." for EXTRA_SERVERS' hosts (octopus/rl/adapter_push.py)
RELEASE=                    # file of "HOST PIDFILE PATTERN" lines (search_eval_queue.sh format) the watcher also releases

# trainer
MB_TOKENS=65536             # the run's; changeable live: MB_TOKENS=... in $RUN/live.env
CHUNK_MAJOR=1               # #338 (and #354, or NaN gradients): OCTOPUS_CHUNK_MAJOR=1 + OCTOPUS_BLOCK_CHECKPOINT=1; 0: the streamed path with #327 blocks
CHUNK_TOKENS=32768
NCCL_P2P_DISABLE=0          # NVLink (node-138's PCIe A6000s ran 1)

# admission (docs/search-env.md "Admission"); NS = rollout servers in all, POOL = a server's KV tokens
CONCURRENT=6                # groups of 8 episodes at once: ~ NS x POOL / 684K (10-28: 7 on 7 servers of 684K)
ROUTE_KV=0.5 ROUTE_CAP=16 ROUTE_WAIT=800
ROUTE_TREE_TOKENS=40000     # a server holds <= max(1, ROUTE_KV x POOL / it) active episode trees, all routers
                            # (10-28 load; 68000 = time-averaged P75 tree footprint; docs/search-env.md "Admission")
