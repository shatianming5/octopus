# newhost.sh settings for the trainer on node-68 (7x RTX 4090D 48 GB, 440 GB RAM, PCIe; lab host, user user) with the
# rollout servers and the search service on node-134 and the judge on node-67 (10-30 switch, README "Trainer on node-68
# (10-30)"): TRAIN_GPUS=... ROLLOUTS=... NEWHOST_ENV=$PWD/newhost-68.env bash newhost.sh CMD, on node-68.
# Paths as newhost-134.env: /home/user/search-v9-134 is a real dir here, a symlink on node-134; venvs are node-68's
# ~/octo-env ones (the AReaL venv's pip freeze equals node-134's but tantivy, which only the search service needs).
ROOT=/home/user/search-v9-134
O=/home/user/octo-env
AREAL_PY=$O/areal/.venv/bin/python
SGLANG_PY=$O/sglang-venv/bin/python     # sglang 0.5.19; same path on node-134 (the remote rollout servers)
CURSOR=$ROOT/cursor                     # areal/ and sglang/, copied from node-134 (sha256 of every file equal)
HARBOR=/home/user/harbor-udocker
SEARCH_PY=/home/user/harbor-udocker/uv-tools/harbor/bin/python  # Harbor 0.23.0, as node-134
CU=/usr/local/cuda-12.4                 # no 12.9 here; the trainer's kernels need no nvcc (triton has its own ptxas)
MODEL_VL=$O/models/Qwen3.5-4B
MODEL_TEXT=$O/models/Qwen3.5-4B-text
JUDGE_MODEL=
FILEROOT=$ROOT/run
SEARCH_ROOT=                            # the search service stays on node-134 (TUNNELS)
TOKENIZER=
QUESTIONS=$O/search/openresearcher-questions.jsonl  # md5 dcadeb557f32d4dcf75f195d1c0ce402
SPLIT=$ROOT/data/rest2-qids.txt         # md5 abb8f1a678c7cf10fda3916785c763ec
RUN=$ROOT/run
SPOOL_REPO=octopus-org/search-v9-ckpt

# layout, given at launch: the trainer on node-68 GPUs 0-5 (6 is another user's), every rollout server on node-134
# (never its GPU 5), reached at 198.51.100.134 (node-68 has no other route to it)
TRAIN_GPUS=${TRAIN_GPUS:?TRAIN_GPUS=a,b: node-68 cards for the trainer, fsdp d = their number (README "Trainer on node-68 (10-30)")}
ROLLOUTS=${ROLLOUTS:?ROLLOUTS=user@198.51.100.134:gpu:port ...: one 4B server per node-134 card}
case ",$TRAIN_GPUS," in *,[6-9],*) echo "node-68 GPUs 0-5 only"; exit 1;; esac
for pg in $ROLLOUTS; do case $pg in user@198.51.100.134:[0-46-7]:*) ;; *) echo "$pg: node-134 cards only, not GPU 5"; exit 1;; esac; done
R_CU=/usr/local/cuda-12.9
R_TMPDIR=/mnt/disk4/user/tmp      # node-134's root fs is full: nvcc fails in /tmp
# search (node-134 :32600) and judge (node-67, through node-134) on this host's 127.0.0.1
TUNNELS="32600:user@198.51.100.134:127.0.0.1:32600 32500:user@198.51.100.134:10.0.2.167:32500"
JUDGE_GPUS=
JUDGE_MEM=
JUDGE_MAMBA_SLOTS=
SHARED=1                                # newhost-134.env's rules: need + 6 GiB free; a server at free - 6.5 GiB
TRAIN_MIB=36864
ROLLOUT_MIB=12288
JUDGE_URL=http://127.0.0.1:32500/v1
EXTRA_SERVERS=
ADAPTER_PUSH=
RELEASE=$K/newhost-68.release           # node-134's search service, the node-67 judge
# host RAM: a trainer rank peaked at 64 GiB (PSS, node-134 d3, step 43 ppo_update), a rollout server's AReaL worker +
# proxy 5.2 GiB; node-68 has ~400 GiB available: with 6 servers d5 needs 356, d6 420 (README "Trainer on node-68 (10-30)")
RANK_GIB=64
SERVER_GIB=6

# trainer
MB_TOKENS=65536
CHUNK_MAJOR=1
CHUNK_TOKENS=32768
NCCL_P2P_DISABLE=1

# admission: as newhost-134.env (sum max_total_num_tokens over node-134's RUN/logs/rollout-g*.log / 684K)
CONCURRENT=${CONCURRENT:-$(wc -w <<< "$ROLLOUTS")}
ROUTE_KV=0.5 ROUTE_CAP=16 ROUTE_WAIT=800
ROUTE_TREE_TOKENS=40000
