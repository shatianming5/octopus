+def _read_range(cache, parent, mount: dict, tokenizer) -> tuple[tuple, dict]:
+    """A read (docs/cross-branch-read.md): mount = {"from": reply id, "to": reply id, "thread": name, "ended"?}, two
+    replies of one thread of this session, "from" "to" or before it. The mounted tokens: read_range in "to"'s input +
+    output tokens (what the server's cursor of "to" holds). Returns (source reply, start, end) for the engine and the
+    record kept on the reader's interaction: the source interaction, that token range in its concat tokens, and `at`,
+    the index in the reader's tokens of the first token computed with the mount."""
+    if parent is None:
+        raise ValueError("a mount needs a cursor request")
+    a, b = cache.get(mount.get("from")), cache.get(mount.get("to"))
+    if a is None or b is None or a.output_message_list is None or b.output_message_list is None:
+        raise CursorError(f"mount {mount} does not name finished replies of this session")
+    x = b
+    while x is not None and x is not a:
+        x = x.parent
+    if x is None:
+        raise ValueError(f"mount {mount}: reply {mount['from']} is not {mount['to']} or before it in one thread")
+    src, p, n = b.model_response, parent.model_response, len(b.model_response.input_tokens)
+    start, end = read_range(tokenizer, mount, a.model_response.input_tokens, src.input_tokens, n + len(src.output_tokens))
+    record = {"thread": mount.get("thread"), "source": mount["to"], "start": start, "end": end,
+              "at": len(p.input_tokens) + len(p.output_tokens)}
+    return (src, start, end), record
+
