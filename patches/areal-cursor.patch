+def _parent_cursor(req: ModelRequest, server_addr: str) -> tuple[str, int] | None:
+    """(id, n): the parent reply's SGLang cursor, when it lives on server_addr and
+    holds req.input_ids[:n] (its input + output tokens; text only). Not when the
+    reply stopped on a token concat replaces, e.g. <|endoftext|> by eos."""
+    p = req.parent
+    if not (p and p.cursor and p.cursor[0] == server_addr) or req.image_data:
+        return None
+    n, m = len(p.input_tokens), len(p.input_tokens) + len(p.output_tokens)
+    ids = req.input_ids
+    if ids[:n] == p.input_tokens and ids[n:m] == p.output_tokens:
+        return p.cursor[1], m
+    return None
+
