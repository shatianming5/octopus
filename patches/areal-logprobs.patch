+def _openai_choice_logprobs(response: "ModelResponse") -> ChoiceLogprobs | None:
+    """OpenAI choices[0].logprobs from SGLang output_token_logprobs / output_top_logprobs."""
+    tops = getattr(response, "output_top_logprobs", None)
+    if tops is None:
+        return None
+    tokenizer = response.tokenizer
+    content: list[ChatCompletionTokenLogprob] = []
+    for i, (tid, lp) in enumerate(zip(response.output_tokens, response.output_logprobs)):
+        token = tokenizer.decode([tid]) if tokenizer is not None else str(tid)
+        top_items: list[TopLogprob] = []
+        row = tops[i] if i < len(tops) and tops[i] is not None else []
+        for item in row:
+            if isinstance(item, dict):
+                t = str(item.get("token") or item.get("text") or "")
+                p = float(item["logprob"])
+            else:
+                p = float(item[0])
+                if len(item) > 2 and item[2] is not None:
+                    t = str(item[2])
+                elif tokenizer is not None:
+                    t = tokenizer.decode([int(item[1])])
+                else:
+                    t = str(item[1])
+            raw = list(t.encode("utf-8"))
+            top_items.append(TopLogprob(token=t, logprob=p, bytes=raw))
+        raw = list(token.encode("utf-8"))
+        content.append(
+            ChatCompletionTokenLogprob(
+                token=token, logprob=float(lp), bytes=raw, top_logprobs=top_items
+            )
+        )
+    return ChoiceLogprobs(content=content)
+
+
